# AISLabz Articles Engine — environment variables (NAMES ONLY; never commit values).
# Copy to .env for local/Hostinger use, or set as GitHub Actions secrets/variables.

# --- Engine behaviour ---
ARTICLE_ENGINE_ENABLED=true
# Keep false until you have reviewed several generated drafts.
ARTICLE_AUTO_PUBLISH=false
# IANA time zone, e.g. Europe/London, America/New_York (default UTC)
ARTICLE_ENGINE_TIMEZONE=
ARTICLE_PUBLISH_DAY=TUESDAY
ARTICLE_PUBLISH_HOUR=09
REQUIRE_FEATURED_IMAGE=false
AUTO_UPDATE_INTERNAL_LINKS=false
# Seconds to keep polling the live URL after deploy before marking publication_failed (default 600)
POST_PUBLISH_VERIFY_TIMEOUT_SECONDS=

# --- Site / output ---
# Defaults to siteUrl in config/site.json
SITE_URL=
# Where /articles/ HTML is written. Default ./dist. On Hostinger with direct file access, point at public_html.
ARTICLES_OUTPUT_DIR=
# Editorial database directory (default ./data)
ARTICLES_DATA_DIR=

# --- LLM (required to generate) ---
# openai | anthropic
LLM_PROVIDER=
# Exact model id from your provider (no default is assumed)
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_CALLS_PER_RUN=30
# Monthly token ceiling across all runs; 0 disables the guard
LLM_MONTHLY_TOKEN_BUDGET=0

# --- Research (required: without it the engine stops and flags the topic) ---
# brave | tavily
RESEARCH_PROVIDER=
RESEARCH_API_KEY=
RESEARCH_MAX_REQUESTS=8
RESEARCH_MAX_SOURCES=10

# --- Featured images (optional; uses OPENAI_API_KEY) ---
# openai | (empty = store brief for manual production)
IMAGE_PROVIDER=
IMAGE_MODEL=

# --- Google Search Console (optional) ---
# e.g. sc-domain:aislabz.com or https://www.aislabz.com/
GOOGLE_SEARCH_CONSOLE_PROPERTY=
# Service-account key JSON (raw JSON or base64 of it)
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Admin interface & cron endpoint ---
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
ADMIN_USERNAME=
# Generate with: echo -n 'your-long-password' | node bin/engine.js hash-password
ADMIN_PASSWORD_HASH=
# Random string, at least 32 characters (e.g. openssl rand -base64 48)
ADMIN_SESSION_SECRET=
# Bearer token for POST /cron/run (Hostinger cron)
CRON_SECRET=

# --- Notifications (optional; Slack/Teams/Discord-compatible incoming webhook) ---
NOTIFY_WEBHOOK_URL=
